# ==============================================================================
# Multi-Agent Legacy Code Modernization Platform
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to '.env' for local development.
# - NEVER commit real credentials, keys, or production secrets.
# ==============================================================================

# Application Identity & Lifecycle
# ------------------------------------------------------------------------------
# APP_NAME: Public human-readable application name
APP_NAME=ModernizationPlatform
# APP_VERSION: Semantic application version
APP_VERSION=0.1.0
# ENVIRONMENT: Runtime environment ('development', 'test', 'staging', 'production')
# [Mandatory in production]
ENVIRONMENT=development
# DEBUG: Enable debug mode. MUST BE false in production!
# [Development-only]
DEBUG=false

# Server Networking
# ------------------------------------------------------------------------------
# HOST: Interface IP address to bind server
HOST=0.0.0.0
# PORT: TCP port to listen on
PORT=8000
# API_V1_PREFIX: Prefix for version 1 API routes
API_V1_PREFIX=/api/v1

# Security & Traffic Filtering
# ------------------------------------------------------------------------------
# ALLOWED_HOSTS: Comma-separated list of allowed HTTP Host headers
# [In production, must be explicitly set to the platform domain]
ALLOWED_HOSTS=["*"]

# CORS_ALLOWED_ORIGINS: JSON list of allowed origins for cross-origin requests
# [Restrict in production to authorized frontend origins. Wildcards with credentials forbidden]
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# CORS_ALLOW_CREDENTIALS: Allow cookies/auth headers across origins
CORS_ALLOW_CREDENTIALS=true

# API Documentation
# ------------------------------------------------------------------------------
# DOCS_ENABLED: Expose Swagger UI (/docs) and ReDoc (/redoc)
# [Recommended: false in production unless protected by VPN or policy]
DOCS_ENABLED=true

# Logging & Correlation
# ------------------------------------------------------------------------------
# LOG_LEVEL: Minimum log severity ('DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL')
LOG_LEVEL=INFO
# LOG_FORMAT: 'json' for production structured logs, 'console' for human-readable dev logs
LOG_FORMAT=console
# CORRELATION_HEADER_NAME: Header used for client request correlation
CORRELATION_HEADER_NAME=X-Correlation-ID

# Health Checks
# ------------------------------------------------------------------------------
# HEALTH_CHECK_TIMEOUT_SECONDS: Max execution time for readiness probes
HEALTH_CHECK_TIMEOUT_SECONDS=5.0

# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Asynchronous connection string for application runtime role
# [Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>]
DATABASE_URL=postgresql+asyncpg://modernizer_app:modernizer_local_dev_pwd@localhost:5432/modernizer_dev
# DATABASE_TEST_URL: Optional dedicated test database for PostgreSQL integration tests
# DATABASE_TEST_URL=postgresql+asyncpg://modernizer_app:modernizer_local_dev_pwd@localhost:5433/modernizer_test
# DB_POOL_SIZE: Connection pool base size
DB_POOL_SIZE=10
# DB_MAX_OVERFLOW: Max burst connections beyond pool size
DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT_SECONDS: Timeout waiting for free connection
DB_POOL_TIMEOUT_SECONDS=30.0
# DB_POOL_RECYCLE_SECONDS: Connection recycling interval in seconds
DB_POOL_RECYCLE_SECONDS=1800
# DB_CONNECT_TIMEOUT_SECONDS: Socket connection timeout
DB_CONNECT_TIMEOUT_SECONDS=10.0
# DB_STATEMENT_TIMEOUT_MS: PostgreSQL statement execution timeout in ms
DB_STATEMENT_TIMEOUT_MS=30000
# DB_APPLICATION_NAME: Connection application name identifier
DB_APPLICATION_NAME=modernization_platform
# DB_ECHO: Log raw SQL statements (strictly false in staging/production)
DB_ECHO=false
# DB_SSL_MODE: PostgreSQL TLS mode ('disable', 'allow', 'prefer', 'require', 'verify-ca', 'verify-full')
DB_SSL_MODE=prefer

